# Copy to .env.local and fill in your values.
# Every variable the app reads is declared in lib/config/env.ts.

# Data provider. Written on purpose: the app never guesses it from other variables.
DB_DRIVER=postgres

# Local PostgreSQL started with `npm run test:db:up`
DATABASE_URL=postgres://postgres:dev@127.0.0.1:55432/pollo

# Auth secrets, at least 32 characters (generate with: openssl rand -base64 48)
JWT_SECRET=your_secret_key_here_min_32_chars
SERVER_SECRET=your_server_secret_here_min_32_chars

# Optional: enables the daily cleanup endpoint /api/cron/cleanup-rate-limits
CRON_SECRET=

# Temporary: still read by the old realtime client (lib/supabase/realtime.ts),
# and the list page fails to load without them. They go away with the SSE rewrite.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
